# Copy to an ignored .env.production and replace all placeholders.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=trpggame
MYSQL_USER=trpg
MYSQL_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SHARED_SECRET=replace-with-at-least-32-random-characters
MINIO_ROOT_USER=trpg-storage-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-admin-password
MINIO_ACCESS_KEY=trpg-scripts-user
MINIO_SECRET_KEY=replace-with-a-strong-business-password
MINIO_BUCKET=trpg-scripts
MILVUS_ACCESS_KEY=trpg-milvus-user
MILVUS_SECRET_KEY=replace-with-a-strong-milvus-password
DEEPSEEK_API_KEY=
AI_ENABLED=true
EMBEDDING_PREWARM=true
GAME_MEMORY_NEW_ROOMS_ENABLED=false
GAME_SUMMARY_ENABLED=true
GAME_SUMMARY_TRIGGER_ACTIONS=5
GAME_SUMMARY_POLL_INTERVAL_MS=2000
GAME_SUMMARY_TIMEOUT_SECONDS=50
GAME_SUMMARY_LEASE_SECONDS=90
CONTEXT_INPUT_BUDGET=24000
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_SAFETY_TOKENS=1024
CONTEXT_SUMMARY_BUDGET=3000
CONTEXT_KEY_EVENT_BUDGET=2000
LLM_MAX_TOKENS=4096
WEBSOCKET_ALLOWED_ORIGINS=https://game.example.com
# Put a TLS reverse proxy in front of this loopback-only HTTP entry.
HTTP_BIND=127.0.0.1:8088
