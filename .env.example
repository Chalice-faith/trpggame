# Copy this file to .env before starting the Docker Compose stack.
# Never commit the real .env file or API keys.

# MySQL credentials used by the database container and Go backend.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=trpggame
MYSQL_USER=trpg
MYSQL_PASSWORD=replace-with-a-strong-database-password

# Zhipu GLM API key used by the Python AI service.
# The application can start without it, but LLM inference will be unavailable.
GLM_API_KEY=

# Shared secret used to authenticate Python-to-Go internal callbacks.
# Replace this value outside local development.
INTERNAL_SHARED_SECRET=replace-with-a-long-random-value
