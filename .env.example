# Copy this file to .env before starting the Docker Compose stack.
# Never commit the real .env file or API keys.

# MySQL credentials used by the database container and Go backend.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=trpggame
MYSQL_USER=trpg
MYSQL_PASSWORD=replace-with-a-strong-database-password

# DeepSeek / OpenAI-compatible Chat Completions provider used by Python AI.
# The application can start without it, but LLM inference will be unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=120
GAME_SUMMARY_ENABLED=true
GAME_SUMMARY_TRIGGER_ACTIONS=5
GAME_SUMMARY_POLL_INTERVAL_MS=2000
GAME_SUMMARY_TIMEOUT_SECONDS=50
GAME_SUMMARY_LEASE_SECONDS=90

# Development MinIO: these credentials are shared by Go, Python, Milvus and MinIO.
# Existing volumes created with other credentials require an explicit migration.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trpg-scripts
AI_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_PREWARM=false
GAME_MEMORY_NEW_ROOMS_ENABLED=false

# Shared secret used to authenticate Python-to-Go internal callbacks.
# Replace this value outside local development.
INTERNAL_SHARED_SECRET=replace-with-a-long-random-value

# Browser origins allowed to open game or IM WebSocket connections.
# Use complete origins only; wildcards and URL paths are rejected.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Vue development defaults (vue-frontend/.env).
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_IM_WS_URL=ws://localhost:8080/ws/im
